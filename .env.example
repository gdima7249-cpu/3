# Reddit app (https://www.reddit.com/prefs/apps, type "script"). Без них — публичный JSON (часто блокируется с серверов).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=faceless-factory/0.1 by u/your_username

# Адаптация историй через Claude (adapter = "claude")
ANTHROPIC_API_KEY=

# ElevenLabs (tts.engine = "elevenlabs")
ELEVENLABS_API_KEY=

# Telegram: новый бот от @BotFather; chat id заполнит `faceless setup`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# TikTok Content Posting API (user access token со scope video.publish)
TIKTOK_ACCESS_TOKEN=
