# Токен от @BotFather (новый бот, не тот, что у SkinWatch)
BOT_TOKEN=123456789:AA...
# Кому бот отвечает и шлёт уведомления. Можно оставить пустым: владельцем станет первый, кто напишет боту /start.
# Узнать свой id: напишите боту /id. Несколько — через запятую.
ALLOWED_CHAT_IDS=

# Товары, которые бот добавит сам при запуске (через запятую). Можно и просто прислать ссылку боту.
ITEM_URLS=https://market.yandex.ru/cc/BPiBbv

# ---------- Расписание ----------
# Время проверок (через запятую), по часовому поясу TIMEZONE. Две проверки: CHECK_TIMES=10:00,22:00
CHECK_TIMES=12:00
TIMEZONE=Europe/Moscow
# Сколько раз в сутки бот может открыть страницу одного товара — вместе с повторами после ошибок и /check
MAX_CHECKS_PER_DAY=2
# Если проверка не удалась (капча, сбой сети) — повторить через N минут (если лимит позволяет)
RETRY_AFTER_MIN=120
# always — присылать цену после каждой проверки; change — только если что-то изменилось (меняется и в боте: /mode)
NOTIFY_MODE=always

# ---------- Промокод ----------
# Следить за промокодом на странице товара (1 — да, 0 — нет)
PROMO_WATCH=1
# Какой промокод нужен: скидка в процентах (0 — любой)
PROMO_PERCENT=5
# Потолок скидки «до N ₽», если на странице он не написан (пусто — без потолка)
PROMO_MAX_DISCOUNT=

# ---------- Загрузка страницы ----------
# auto — браузер (Playwright) включается, только если обычный запрос упёрся в капчу;
# always — всегда браузером; off — никогда. Браузер нужно установить отдельно (см. README).
BROWSER=auto
# Прокси для браузера, если Маркет не пускает с IP сервера: http://логин:пароль@1.2.3.4:8080
PROXY_URL=
# User-Agent обычных запросов (менять не обязательно)
HTTP_USER_AGENT=
