# Токен от @BotFather
BOT_TOKEN=123456789:AA...
# Ваш chat id (узнать: напишите боту /id). Можно несколько через запятую.
ADMIN_CHAT_IDS=123456789

# 1 — все функции без ограничений (как у УЛЬТРА), тарифы и оплата нигде не показываются.
# 0 — платный режим: Бесплатный / ПРО / УЛЬТРА (ЮMoney / Stars).
FREE_FOR_ALL=0

# ---------- Тарифы (при FREE_FOR_ALL=0) ----------
# Цена в месяц: рубли (ЮMoney) и Telegram Stars (≈2 ₽ за ⭐ для покупателя; 0 — не принимать звёзды)
PRO_PRICE_RUB=99
PRO_STARS=50
ULTRA_PRICE_RUB=999
ULTRA_STARS=500
PREMIUM_DAYS=30
# 1 — подписка Stars с автопродлением каждые 30 дней, 0 — разовая оплата
STARS_SUBSCRIPTION=1
# ЮMoney: заполняется автоматически командой  npm run yoomoney
YOOMONEY_WALLET=
YOOMONEY_TOKEN=

# Лимиты тарифов (0 — без ограничений)
# Скины в уведомлениях
FREE_ALERTS=10
PRO_ALERTS=50
ULTRA_ALERTS=0
# Как часто проверять уведомления о скинах, минут (УЛЬТРА — каждый цикл цен, см. PRICE_REFRESH_MIN)
FREE_ALERT_INTERVAL_MIN=30
PRO_ALERT_INTERVAL_MIN=5
# Игры в вишлисте
FREE_WISHLIST_LIMIT=10
PRO_WISHLIST_LIMIT=50
ULTRA_WISHLIST_LIMIT=0
# Скидки на игры бесплатному тарифу — не чаще раза в N минут (платным — каждую проверку, CHECK_INTERVAL_MIN)
FREE_GAMES_INTERVAL_MIN=60
# Как часто можно обновлять состав инвентаря, часов
FREE_INV_REFRESH_H=6
PRO_INV_REFRESH_H=1
ULTRA_INV_REFRESH_H=0.25
# Закрытый чат УЛЬТРА: id группы, где бот — администратор (см. README). Пусто — чата нет.
ULTRA_CHAT_ID=

# ---------- УЛЬТРА ----------
# Скины других игр (только УЛЬТРА): rust, tf2 через запятую; пусто — только CS2.
# Цены — Steam и Skinport. Если найдёте JSON-выгрузку цен другой площадки — впишите ссылку и валюту.
EXTRA_GAMES=rust,tf2
RUST_PRICES_URL=
RUST_PRICES_CURRENCY=RUB
TF2_PRICES_URL=
TF2_PRICES_CURRENCY=RUB
# Как часто обновлять цены Rust и TF2, минут
GAMES_REFRESH_MIN=60
# «Где выгоднее продать»: комиссия Skinport с продавца, %. Посмотрите на сайте Skinport. Пусто — показываем цену до комиссии.
SKINPORT_SELL_FEE_PCT=
# «Пополнить Steam через скины»: цены предметов, минимум продаж в Steam за сутки, сколько предметов проверять в Steam за час
TOPUP_MIN_PRICE=30
TOPUP_MAX_PRICE=5000
TOPUP_MIN_STEAM_VOLUME=50
TOPUP_STEAM_BATCH=40
# Сигналы: «выгодно купить» — лучшая цена ниже цены продаж на N%; «пора продавать» — продажи недели выше месяца на N%
SIGNAL_BUY_PCT=10
SIGNAL_SELL_PCT=15
# Ежедневный отчёт по инвентарю: в котором часу и по какому часовому поясу
REPORT_HOUR=10
TIMEZONE=Europe/Moscow

# ---------- Расписание ----------
# Обновление цен скинов (Маркет CS, Lis-Skins, Avan), минут. Это же — частота уведомлений УЛЬТРА.
PRICE_REFRESH_MIN=3
# Проверка скидок на игры, минут
CHECK_INTERVAL_MIN=30

# ---------- Регион ----------
STEAM_CC=ru
# Валюта торговой площадки Steam: 5 = рубль
STEAM_CURRENCY=5
SKINPORT_CURRENCY=RUB
# Необязательно: ключ Steam Web API (https://steamcommunity.com/dev/apikey) —
# чтобы принимать ссылки на профиль вида /id/nickname
STEAM_API_KEY=

# ---------- Площадки скинов ----------
# c — Маркет CS, l — Lis-Skins, s — Skinport, a — Avan.Market
SKIN_SOURCES=c,l,s,a
# Выгрузка цен Lis-Skins и её валюта
LISSKINS_PRICES_URL=https://lis-skins.com/market_export_json/csgo.json
LISSKINS_CURRENCY=USD
# Avan.Market: адрес JSON-выгрузки цен (возьмите в документации API Avan или у их поддержки). Пусто — выключено.
AVAN_PRICES_URL=
AVAN_CURRENCY=RUB
# 1 — «Оценка рынка» и «Что купить» только с ПРО
ANALYSIS_PREMIUM_ONLY=1
# Подборка «Что купить»: минимум продаж за неделю и минимальная цена предмета, ₽
INVEST_MIN_VOLUME=15
INVEST_MIN_PRICE=30

# Уведомления об изменении цен в инвентаре (включены у всех по умолчанию):
# не сообщать о позициях дешевле N ₽
INV_ALERT_MIN_RUB=50

# История скидок игр: ключ IsThereAnyDeal (бесплатно: https://isthereanydeal.com/apps/my/ → создать приложение → API key).
# С ключом бот знает лучшую скидку именно в Steam. Без ключа — CheapShark (минимум во всех магазинах, данные бывают неполными).
ITAD_API_KEY=
ITAD_COUNTRY=US
# Важно: нужен именно «Ключ API» из раздела «Ключи API», а не «Идентификатор/Секрет клиента» (OAuth).

# Skinport отвечает 429, если опрашивать часто. Как часто обновлять его цены, минут
SKINPORT_REFRESH_MIN=15
