[Unit]
Description=tgchannel: 5 постов в день

[Timer]
# Время московское; к каждому запуску добавляется случайная задержка до 40 минут,
# чтобы посты не выходили минута в минуту и канал не выглядел роботом.
OnCalendar=*-*-* 09:30:00 Europe/Moscow
OnCalendar=*-*-* 12:30:00 Europe/Moscow
OnCalendar=*-*-* 15:30:00 Europe/Moscow
OnCalendar=*-*-* 18:30:00 Europe/Moscow
OnCalendar=*-*-* 21:00:00 Europe/Moscow
RandomizedDelaySec=40min
Persistent=false

[Install]
WantedBy=timers.target
