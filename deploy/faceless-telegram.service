[Unit]
Description=faceless: забрать истории, присланные боту в Telegram
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/faceless/app
ExecCondition=/opt/faceless/app/.venv/bin/python -m faceless ready --publish
ExecStart=/opt/faceless/app/.venv/bin/python -m faceless telegram-sync
User=faceless
Nice=15
TimeoutStartSec=2min
