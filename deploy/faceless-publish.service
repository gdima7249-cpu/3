[Unit]
Description=faceless: загрузить очередь на YouTube/TikTok
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/faceless/app
# Пока не подключены ни Telegram, ни YouTube, запуск тихо пропускается
ExecCondition=/opt/faceless/app/.venv/bin/python -m faceless ready --publish
ExecStart=/opt/faceless/app/.venv/bin/python -m faceless publish
User=faceless
# Telegram-бот на этом же сервере всегда в приоритете: рендер получает CPU/диск по остаточному принципу
Nice=15
CPUWeight=20
IOWeight=20
# Память: при нехватке система должна убить сборку ролика, а не ваш бот (OOMScoreAdjust)
MemoryHigh=300M
MemoryMax=450M
MemoryLimit=450M
OOMScoreAdjust=900
TimeoutStartSec=3h
